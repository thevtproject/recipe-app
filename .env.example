# PostgreSQL
POSTGRES_USER=recipe_user
POSTGRES_PASSWORD=changeme_secure_password_here
POSTGRES_DB=recipe_db

# Database URL (app container connects to `db` service)
DATABASE_URL=postgresql://recipe_user:changeme_secure_password_here@db:5432/recipe_db

# Next.js Auth
NEXTAUTH_SECRET=changeme_generate_with_openssl_rand_base64_48
NEXTAUTH_URL=https://recipes.vtproject.my.id

# Upload directory (inside container)
UPLOAD_DIR=/app/public/uploads

# Cloudflare Tunnel (get from: cloudflared tunnel token recipe-app)
CLOUDFLARE_TUNNEL_TOKEN=changeme_paste_tunnel_token_here

# Initial admin seed (optional, used by: npx prisma db seed)
SEED_ADMIN_EMAIL=admin@family.local
SEED_ADMIN_PASSWORD=changeme_initial_admin_password
