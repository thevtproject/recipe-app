# PostgreSQL
POSTGRES_USER=recipe_user
POSTGRES_PASSWORD=<generate: openssl rand -base64 32>
POSTGRES_DB=recipe_db

# Database URL (prod app container connects to `db` service)
DATABASE_URL=postgresql://recipe_user:<POSTGRES_PASSWORD>@db:5432/recipe_db

# Dev/staging database (dev app container connects to `db-dev` service)
DEV_DATABASE_URL=postgresql://recipe_dev:<POSTGRES_PASSWORD>@db-dev:5432/recipe_dev_db
DEV_NEXTAUTH_URL=https://<dev-domain>

# Next.js Auth
NEXTAUTH_SECRET=<generate: openssl rand -base64 48>
NEXTAUTH_URL=https://<your-domain>

# Upload directory (inside container)
UPLOAD_DIR=/app/public/uploads

# Cloudflare Tunnel (get from: cloudflared tunnel token recipe-app)
CLOUDFLARE_TUNNEL_TOKEN=<generate from: cloudflared tunnel token recipe-app>

# Host directory containing cloudflared config.yml and tunnel credentials JSON
CLOUDFLARED_CONFIG_DIR=./cloudflared

# Initial admin seed (optional, used by: npx prisma db seed)
SEED_ADMIN_EMAIL=admin@family.local
SEED_ADMIN_PASSWORD=<generate: openssl rand -base64 32>

# Nginx server_name routing (consumed by nginx envsubst at container start)
DEV_DOMAIN=<dev-domain>
PROD_DOMAIN=<prod-domain>
